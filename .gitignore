# ============================================================================
# Cosa NON deve uscire da questa macchina.
#
# Le regole sono per CATEGORIA e per estensione, non per percorso preciso: una
# regola come "res/*.csv" non copre lo stesso file scaricato nella radice, ed e'
# esattamente cosi' che l'export di un'asta vera — con nomi e prezzi di tutti —
# era finito in un commit.
# ============================================================================

# ---- Build ----------------------------------------------------------------
target/
*.class
*.jar

# ---- Segreti --------------------------------------------------------------
# Il modello versionato e' .env.example, con i valori vuoti.
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*

# ---- Dati della lega e delle aste -----------------------------------------
# Nomi e iniziali sono di persone che non hanno scelto di comparire online: il
# modello versionato e' res/league-members.example.yml, da copiare e riempire.
res/league-members.yml
# Preferenze scritte dall'applicazione, non configurazione di progetto.
res/auction-settings.yml
# I registri d'asta: ogni acquisto, con prezzo e acquirente.
res/auctions/
# Le aste cancellate dalla home: stessi registri, spostati nel cestino.
res/auctions-cestino/
res/dossiers/
data/auctions/
data/auctions-cestino/
data/dossiers/
*.jsonl

# ---- Dati di terzi --------------------------------------------------------
# Listone, statistiche e griglie vengono da Fantacalcio.it: non sono nostri da
# ridistribuire. Chi clona il progetto li scarica dalla loro area download.
*.xlsx
*.xls
data/reference/normalized.json

# ---- Prodotti dell'applicazione -------------------------------------------
# Export delle rose: contiene i nomi dei partecipanti e l'asta intera, e finisce
# dove capita di scaricarlo — spesso nella radice del progetto.
*.csv
llm-calls.jsonl
logs/
*.log
img/

# ---- Copie di sicurezza ---------------------------------------------------
# Un archivio del repository contiene la cronologia PRIMA di qualunque pulizia:
# rimetterlo dentro il repository rimetterebbe online cio' che si era tolto.
*.tgz
*.tar.gz
*.zip
*.bak
_backup/

# ---- Strumenti, IDE, sistema operativo ------------------------------------
.superpowers/
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
