{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/PublicBidderDialog.tsx", "src/routes/ProjectionRoute.tsx"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [{
            "group": ["**/PlayerDecisionCard*", "**/BidderDialog*"],
            "message": "La proiezione non puo' importare componenti che mostrano valutazioni."
          }]
        }]
      }
    }
  ]
}
